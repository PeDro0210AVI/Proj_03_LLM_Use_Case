# Copy this file to .env and fill in your values.
# .env is loaded automatically at startup (see src/config.rs) and is
# git-ignored, so real secrets never get committed.

# Required: your Anthropic API key.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Claude model to use.
CLAUDE_MODEL=claude-opus-5

# Optional: max output tokens per reply.
CLAUDE_MAX_TOKENS=4096

# Required: the MCP server this chatbot talks to.
MCP_SERVER_URL=https://mcp.pedro021.com

# Optional: internal label for the MCP server (shown to Claude, not to you).
MCP_SERVER_NAME=pedro021-mcp

# Optional: bearer token if the MCP server requires authentication.
# MCP_AUTH_TOKEN=

# Local MCP servers, spawned as child processes and driven by this app
# directly (not via mcp.pedro021.com — these run on your machine, not
# Anthropic's, so they need `npx`/`uvx` on PATH; both are provided by
# `nix develop`). Set to an empty string to disable either one.

# Directory the filesystem MCP server (@modelcontextprotocol/server-filesystem)
# is allowed to read/write. Defaults to "." if unset.
MCP_FILESYSTEM_ROOT=.

# Git repository the git MCP server (mcp-server-git) operates on.
# Defaults to "." if unset.
MCP_GIT_REPO_PATH=.
